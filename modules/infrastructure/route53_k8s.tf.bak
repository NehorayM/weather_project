resource "aws_route53_record" "app" {
  zone_id = var.zone_id
  name    = "${var.environments["prod"].subdomain}.${var.domain_name}"
  type    = "A"

  alias {
    name                   = data.aws_lb.k8s.dns_name
    zone_id                = data.aws_lb.k8s.zone_id
    evaluate_target_health = true
  }
}

